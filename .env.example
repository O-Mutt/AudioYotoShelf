# Database
DB_PASSWORD=change_this_to_a_strong_password

# Yoto Developer API (https://developers.yotoplay.com)
YOTO_CLIENT_ID=your_client_id_here
YOTO_CLIENT_SECRET=your_client_secret_here

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended: the one Audiobookshelf server this app connects to. When set, the setup screen
# stops asking for a URL and the app refuses to connect anywhere else. Leave unset to let users
# enter any server URL.
AUDIOBOOKSHELF_URL=

# Needed for single sign-on when AUDIOBOOKSHELF_URL is an internal name (for example
# http://audiobookshelf:80): the address browsers reach Audiobookshelf at. Audiobookshelf builds
# the identity provider's return address from the host it was called on.
AUDIOBOOKSHELF_PUBLIC_URL=

# Optional: Change the exposed port
BRIDGE_PORT=8080

# Optional: which published image tag docker compose pulls — latest (newest release), edge (main), or
# a pinned version such as 0.1.0.
AYS_TAG=latest

# Set to true when a reverse proxy (Caddy, Traefik, nginx, …) terminates HTTPS in front of the app, so
# the Yoto and SSO callback URLs are built as https://. The proxy must pass the original Host header.
# Leave false when nothing sits in front: it trusts X-Forwarded-* headers from any client.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# Optional: the Hangfire background-job dashboard at /hangfire. It has no login of its own, so it is
# off by default; if you turn it on, restrict /hangfire at your proxy or network.
HANGFIRE_DASHBOARD_ENABLED=false

# Optional: logging. LOG_LEVEL is Verbose, Debug, Information, Warning or Error; SEQ_URL also ships
# logs to a Seq server.
LOG_LEVEL=Information
SEQ_URL=

# Optional: admin analytics access. Admin is granted only to ADMIN_USERNAMES users who log in
# against the trusted server ADMIN_AUDIOBOOKSHELF_URL — never from an arbitrary login URL. Leave
# ADMIN_AUDIOBOOKSHELF_URL unset to disable admin promotion entirely.
ADMIN_AUDIOBOOKSHELF_URL=
ADMIN_USERNAMES=
